rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // Customer visits and uPVC fabricator sales entries
    match /customer_visits/{visitId} {
      allow read: if true;
      allow write: if isValidId(visitId);
    }

    // uPVC Profile Cutting & Wastage Optimization Projects
    match /upvc_wastage_projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
