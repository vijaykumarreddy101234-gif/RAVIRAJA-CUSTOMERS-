{
  "entities": {
    "CustomerVisit": {
      "title": "CustomerVisit",
      "description": "SCRAFT uPVC profile customer visit and fabricator sales entry record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "salesExecutiveName": { "type": "string" },
        "customerVisitDate": { "type": "string" },
        "customerName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "companyName": { "type": "string" },
        "gstNumber": { "type": "string" },
        "customerType": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "city": { "type": "string" },
        "customerAddress": { "type": "string" },
        "gpsLocationLink": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "brand": { "type": "string" },
        "interestedSeries": { "type": "string" },
        "interestedBrand": { "type": "string" },
        "currentBrand": { "type": "string" },
        "quantityPerMonth": { "type": "string" },
        "piSent": { "type": "string" },
        "leadStatus": { "type": "string" },
        "followUpDate": { "type": "string" },
        "visitRemarks": { "type": "string" },
        "executiveEmail": { "type": "string" },
        "userId": { "type": "string" },
        "photos": { "type": "array" },
        "customerId": { "type": "string" },
        "visitId": { "type": "string" },
        "visitingCardPhoto": { "type": "string" },
        "pinCode": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "emailAddress": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["customerName", "mobileNumber", "customerVisitDate"]
    },
    "SalesEmployee": {
      "title": "SalesEmployee",
      "description": "SCRAFT sales executive or administrator profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "employeeCode": { "type": "string" },
        "designation": { "type": "string" },
        "assignedState": { "type": "string" },
        "assignedDistrict": { "type": "string" },
        "joiningDate": { "type": "string" },
        "status": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "mobileNumber", "employeeCode", "role", "status"]
    },
    "UPVCWastageProject": {
      "title": "UPVCWastageProject",
      "description": "uPVC profile cutting optimization project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectName": { "type": "string" },
        "fabricatorName": { "type": "string" },
        "stockLengthMm": { "type": "number" },
        "sawKerfMm": { "type": "number" },
        "profileWeightKgPerM": { "type": "number" },
        "costPerKg": { "type": "number" },
        "minUsableOffcutMm": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "projectName"]
    },
    "loginChallenges": {
      "title": "LoginChallenge",
      "description": "Stateful 2FA login challenge tracking",
      "type": "object",
      "properties": {
        "challengeId": { "type": "string" },
        "userId": { "type": "string" },
        "mobile": { "type": "string" },
        "email": { "type": "string" },
        "msg91RequestId": { "type": "string" },
        "mobileVerified": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "emailOtpHash": { "type": "string" },
        "emailOtpExpiresAt": { "type": "number" },
        "attempts": { "type": "number" },
        "expiresAt": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "sessions": {
      "title": "Session",
      "description": "Server-side authenticated session",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "revokedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/customer_visits/{visitId}": {
      "schema": { "$ref": "#/entities/CustomerVisit" },
      "description": "Collection of customer visits"
    },
    "/sales_employees/{empId}": {
      "schema": { "$ref": "#/entities/SalesEmployee" },
      "description": "Directory of sales personnel"
    },
    "/upvc_wastage_projects/{projectId}": {
      "schema": { "$ref": "#/entities/UPVCWastageProject" },
      "description": "Cutting optimization projects"
    },
    "/login_challenges/{challengeId}": {
      "schema": { "$ref": "#/entities/loginChallenges" },
      "description": "Active 2FA challenges"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/sessions" },
      "description": "Active user sessions"
    }
  }
}
